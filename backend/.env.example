# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://worksphere:worksphere_secret_2026@localhost:5432/worksphere_ai?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="ws-ai-super-secret-key-change-in-production-2026"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="ws-ai-refresh-secret-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="30d"

# OpenAI (for AI features)
OPENAI_API_KEY="sk-your-openai-key-here"
OPENAI_MODEL="gpt-4"

# File Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# Frontend URL (CORS)
FRONTEND_URL="http://localhost:3000"

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="noreply@worksphere.ai"
SMTP_PASS="your-app-password"
